# ==========================================
# YACE PRODUCTION-READY ENVIRONMENT CONFIG
# ==========================================

# ------------------------------------------
# Section 1: Core Application Settings
# ------------------------------------------
APP_NAME=YACE
APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------
# Section 2: Database Connections
# ------------------------------------------
# Database Provider: local or supabase
DATABASE_PROVIDER=supabase
# Primary database URL
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
# Test database URL (must be different from DATABASE_URL. Use a different schema for free tier)
TEST_DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres?options=-c%20search_path=test_schema

# Supabase Keys (Optional, reserved for future use)
SUPABASE_PROJECT_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------
# Section 3: LLM Settings
# ------------------------------------------
LLM_PROVIDER=gemini

# Gemini Settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=120
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=4096

# Ollama Settings
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_POST_TIMEOUT=120.0
OLLAMA_GENERATE_TIMEOUT=240.0
OLLAMA_CHAT_TIMEOUT=240.0
OLLAMA_HEALTH_TIMEOUT=5.0
OLLAMA_TEMPERATURE=0.7
OLLAMA_TOP_P=0.9
OLLAMA_REPEAT_PENALTY=1.1
OLLAMA_MAX_TOKENS=2048
OLLAMA_NUM_CTX=4096

# ------------------------------------------
# Section 4: Content Generation Bounds
# ------------------------------------------
CONTENT_TOPICS_COUNT=10
CONTENT_MIN_TOPIC_SCORE=70.0
CONTENT_SCRIPT_MIN_WORDS=50
CONTENT_SCRIPT_MAX_WORDS=150

# ------------------------------------------
# Section 5: SEO Bounds
# ------------------------------------------
SEO_TITLE_MAX_LEN=100
SEO_DESCRIPTION_MAX_LEN=5000
SEO_MIN_TAGS_COUNT=15
SEO_MIN_HASHTAGS_COUNT=10

# ------------------------------------------
# Section 6: Piper TTS Settings
# ------------------------------------------
PIPER_EXECUTABLE=.piper/piper/piper.exe
PIPER_MODEL=.piper/en_US-lessac-medium.onnx
PIPER_SAMPLE_RATE=22050
# PIPER_SPEAKER_ID=

# ------------------------------------------
# Section 7: Audio Validation Bounds
# ------------------------------------------
AUDIO_MIN_DURATION_SECONDS=15.0
AUDIO_MAX_DURATION_SECONDS=60.0

# ------------------------------------------
# Section 8: Visual Planning Configurations
# ------------------------------------------
SPEECH_WORDS_PER_SECOND=2.5
SCENE_DURATION_TOLERANCE_BASE_SECONDS=15.0
SCENE_DURATION_TOLERANCE_FRACTION=0.15
SCENE_FALLBACK_KEYWORDS=general visual

# ------------------------------------------
# Section 9: FFmpeg Settings
# ------------------------------------------
FFMPEG_PATH=.ffmpeg/ffmpeg.exe
FFPROBE_PATH=.ffmpeg/ffprobe.exe
FFMPEG_VIDEO_CODEC=libx264
FFMPEG_AUDIO_CODEC=aac
FFMPEG_FRAME_RATE=30
FFMPEG_PIXEL_FORMAT=yuv420p

# ------------------------------------------
# Section 10: Video Rendering Settings
# ------------------------------------------
VIDEO_RESOLUTION_WIDTH=1080
VIDEO_RESOLUTION_HEIGHT=1920
VIDEO_FALLBACK_COLOR=black

# ------------------------------------------
# Section 11: Subtitle Settings
# ------------------------------------------
SUBTITLE_CHARS_PER_LINE=20
SUBTITLE_MAX_LINES=1
SUBTITLE_FONT_NAME=Arial
SUBTITLE_FONT_SIZE=36
SUBTITLE_PRIMARY_COLOR=&H00FFFF
SUBTITLE_ALIGNMENT=5

# ------------------------------------------
# Section 12: Storage Paths
# ------------------------------------------
PATH_SCRIPTS_DIR=generated/scripts
PATH_AUDIO_DIR=generated/audio
PATH_VIDEOS_DIR=generated/videos
PATH_SUBTITLES_DIR=generated/subtitles
PATH_ASSETS_DIR=generated/assets
PATH_FONTS_DIR=assets/fonts
PATH_MUSIC_DIR=assets/music
PATH_TEMPLATES_DIR=assets/templates

# ------------------------------------------
# Section 13: Phase 5 Visual Asset Acquisition Settings
# ------------------------------------------
# Europeana REST API Key (Free, optional)
EUROPEANA_API_KEY=
# Pexels API key (Free, optional, for atmospheric stock footage/images)
PEXELS_API_KEY=
# Unsplash Access Key (Optional, reserved for future use)
UNSPLASH_ACCESS_KEY=

# Settings for resolution filter and query limits
ASSET_MIN_WIDTH=800
ASSET_MIN_HEIGHT=600
ASSET_DOWNLOAD_TIMEOUT=15
ASSET_MAX_RESULTS_PER_QUERY=5
ASSET_SEARCH_ENABLED=True
ASSET_NICHE_SUBDIR=True

# Ken Burns motion engine configurations
MOTION_EFFECTS_ENABLED=True
MOTION_ZOOM_RATE=0.0015
MOTION_DEFAULT_EFFECT=zoom_in

# Word segment counts and casing for short subtitles
SUBTITLE_WORDS_PER_SEGMENT=3
SUBTITLE_UPPERCASE=True

# AI Image Generation (Disabled — Phase 5 architecture hook only)
AI_IMAGE_FALLBACK_ENABLED=False
GEMINI_IMAGE_MODEL=imagen-4.0-generate-preview
MAX_AI_IMAGES_PER_VIDEO=5
