# Normalize line endings to LF on commit
* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Binary files - no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.mp4 binary
*.onnx binary
*.exe binary
*.zip binary
